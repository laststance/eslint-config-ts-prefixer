  "license": "MIT",
  "version": "5.1.0",
  "description": "Ruleset of meaningful Lint rules on runtime with import organization. (eslint-plugin-import-x)",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "eslint.config.mjs",
  "files": [
    "eslint.config.mjs",
    "explicit-void-return-type.mjs"
  ],
  "scripts": {
    "lint": "eslint . -c eslint.config.mjs",
    "lint:fix": "eslint . -c eslint.config.mjs --fix",
    "prettier": "prettier --ignore-unknown --write .",
    "test": "node --test test/*.test.mjs",
    "prepare": "husky",
    "push-release-commit": "push-release-commit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/laststance/eslint-config-ts-prefixer"
  },
  "bugs": {
    "url": "https://github.com/laststance/eslint-config-ts-prefixer/issues"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "homepage": "https://github.com/laststance/eslint-config-ts-prefixer",
  "dependencies": {
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-browser-security": "^3.0.2",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2",
    "eslint-import-resolver-node": "^0.4.0"
  },
  "devDependencies": {
    "@laststance/npm-publish-tool": "^2.1.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.6",
    "all-contributors-cli": "^7.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "release-it": "^21.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": "^5.0.2 || ~6.0.3"
  }
}
